<Window x:Class="MnlzJournal.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование записи" Height="620" Width="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
                <!-- Блок 1: Основное -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Основная информация" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Дата теста" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <DatePicker x:Name="DpDate"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Номер сегмента" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtSegment"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="ФИО сотрудника" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtLastName"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Блок 2: Замеры -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая сторона -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="Левая сторона" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" Foreground="#059669"/>

                            <TextBlock Text="ВХОД" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Верх:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtLeftInTop" Grid.Column="1"/>
                                <TextBlock Text="Низ:" VerticalAlignment="Center" Margin="0,0,8,0" Grid.Column="3"/>
                                <TextBox x:Name="TxtLeftInBottom" Grid.Column="4"/>
                            </Grid>

                            <TextBlock Text="ВЫХОД" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Верх:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtLeftOutTop" Grid.Column="1"/>
                                <TextBlock Text="Низ:" VerticalAlignment="Center" Margin="0,0,8,0" Grid.Column="3"/>
                                <TextBox x:Name="TxtLeftOutBottom" Grid.Column="4"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Правая сторона -->
                    <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="Правая сторона" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" Foreground="#D97706"/>

                            <TextBlock Text="ВХОД" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Верх:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtRightInTop" Grid.Column="1"/>
                                <TextBlock Text="Низ:" VerticalAlignment="Center" Margin="0,0,8,0" Grid.Column="3"/>
                                <TextBox x:Name="TxtRightInBottom" Grid.Column="4"/>
                            </Grid>

                            <TextBlock Text="ВЫХОД" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Верх:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtRightOutTop" Grid.Column="1"/>
                                <TextBlock Text="Низ:" VerticalAlignment="Center" Margin="0,0,8,0" Grid.Column="3"/>
                                <TextBox x:Name="TxtRightOutBottom" Grid.Column="4"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Блок 3: Заметки -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,16,0,0" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="Заметки" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <TextBox x:Name="TxtNotes" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Футер с кнопками -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click" Margin="0,0,12,0"/>
                <Button x:Name="SaveButton" Content="Сохранить" Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>